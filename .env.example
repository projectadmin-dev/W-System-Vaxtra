# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PAT=sbp_xxx

# Application Settings
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=W System v2

# Auth
NEXT_PUBLIC_AUTH_COOKIE_LIFETIME=604800
NEXT_PUBLIC_AUTH_COOKIE_SECURE=true

# ⚠️ SECURITY NOTES:
# - Never commit this file with real values to git
# - Add .env.local to .gitignore
# - SUPABASE_SERVICE_ROLE_KEY and SUPABASE_PAT are server-side only
# - NEXT_PUBLIC_* variables are exposed to client (safe for anon keys)
